generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id            String            @id @default(cuid())
  name          String
  ownerName     String
  mobile        String            @unique
  email         String?           @unique
  passwordHash  String
  currency      String            @default("INR")
  theme         String            @default("light")
  createdAt     DateTime          @default(now())
  auditLogs     AuditLog[]
  DailyBalance  DailyBalance[]
  DrawingsEntry DrawingsEntry[]
  ExpenseEntry  ExpenseEntry[]
  LoanEntry     LoanEntry[]
  materialExp   MaterialExpense[]
  miscExp       MiscExpense[]
  sales         Sale[]
  SalesEntry    SalesEntry[]
  shopExp       ShopExpense[]
  users         User[]
  withdrawals   Withdrawal[]
}

model User {
  id           String   @id @default(cuid())
  shopId       String
  role         Role     @default(OWNER)
  mobile       String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  shop         Shop     @relation(fields: [shopId], references: [id])

  @@index([shopId])
}

model Sale {
  id            String    @id @default(cuid())
  shopId        String
  type          SaleType
  amount        Decimal   @db.Decimal(12, 2)
  paymentMethod String?
  note          String?
  saleDate      DateTime
  createdAt     DateTime  @default(now())
  createdBy     String
  voidedAt      DateTime?
  voidReason    String?
  shop          Shop      @relation(fields: [shopId], references: [id])

  @@index([shopId, saleDate])
}

model MaterialExpense {
  id         String    @id @default(cuid())
  shopId     String
  category   String
  amount     Decimal   @db.Decimal(12, 2)
  mode       PayMode
  note       String?
  expDate    DateTime
  createdAt  DateTime  @default(now())
  createdBy  String
  voidedAt   DateTime?
  voidReason String?
  shop       Shop      @relation(fields: [shopId], references: [id])

  @@index([shopId, expDate])
}

model ShopExpense {
  id          String    @id @default(cuid())
  shopId      String
  category    String
  mode        PayMode
  amount      Decimal   @db.Decimal(12, 2)
  note        String?
  expDate     DateTime
  isRecurring Boolean   @default(false)
  createdAt   DateTime  @default(now())
  createdBy   String
  voidedAt    DateTime?
  voidReason  String?
  shop        Shop      @relation(fields: [shopId], references: [id])

  @@index([shopId, expDate])
}

model MiscExpense {
  id         String    @id @default(cuid())
  shopId     String
  name       String
  mode       PayMode
  amount     Decimal   @db.Decimal(12, 2)
  note       String?
  expDate    DateTime
  createdAt  DateTime  @default(now())
  createdBy  String
  voidedAt   DateTime?
  voidReason String?
  shop       Shop      @relation(fields: [shopId], references: [id])

  @@index([shopId, expDate])
}

model Withdrawal {
  id         String    @id @default(cuid())
  shopId     String
  mode       PayMode
  amount     Decimal   @db.Decimal(12, 2)
  note       String?
  wDate      DateTime
  createdAt  DateTime  @default(now())
  createdBy  String
  voidedAt   DateTime?
  voidReason String?
  shop       Shop      @relation(fields: [shopId], references: [id])

  @@index([shopId, wDate])
}

model AuditLog {
  id          String   @id @default(cuid())
  shopId      String
  entityType  String
  entityId    String
  action      String
  amount      Decimal  @db.Decimal(12, 2)
  performedBy String
  ipAddress   String
  createdAt   DateTime @default(now())
  shop        Shop     @relation(fields: [shopId], references: [id])

  @@index([shopId, createdAt])
}

model DailyBalance {
  id           String   @id
  shopId       String
  date         DateTime
  openingCash  Decimal  @default(0) @db.Decimal(12, 2)
  openingBank  Decimal  @default(0) @db.Decimal(12, 2)
  closingCash  Decimal  @default(0) @db.Decimal(12, 2)
  closingBank  Decimal  @default(0) @db.Decimal(12, 2)
  totalOpening Decimal  @default(0) @db.Decimal(12, 2)
  totalClosing Decimal  @default(0) @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  Shop         Shop     @relation(fields: [shopId], references: [id])

  @@unique([shopId, date])
  @@index([shopId, date])
}

model DrawingsEntry {
  id          String   @id
  shopId      String
  date        DateTime
  amount      Decimal  @db.Decimal(12, 2)
  paymentMode String
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  Shop        Shop     @relation(fields: [shopId], references: [id])

  @@index([shopId, date])
}

model ExpenseEntry {
  id          String   @id
  shopId      String
  date        DateTime
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  paymentMode String
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  Shop        Shop     @relation(fields: [shopId], references: [id])

  @@index([shopId, category])
  @@index([shopId, date])
}

model LoanEntry {
  id             String     @id
  shopId         String
  date           DateTime
  type           LoanType
  personName     String
  amount         Decimal    @db.Decimal(12, 2)
  returnedAmount Decimal    @default(0) @db.Decimal(12, 2)
  pendingAmount  Decimal    @db.Decimal(12, 2)
  status         LoanStatus @default(PENDING)
  note           String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime
  Shop           Shop       @relation(fields: [shopId], references: [id])

  @@index([shopId, status])
  @@index([shopId, type])
}

model SalesEntry {
  id         String   @id
  shopId     String
  date       DateTime
  cashSales  Decimal  @default(0) @db.Decimal(12, 2)
  upiSales   Decimal  @default(0) @db.Decimal(12, 2)
  cardSales  Decimal  @default(0) @db.Decimal(12, 2)
  totalSales Decimal  @default(0) @db.Decimal(12, 2)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  Shop       Shop     @relation(fields: [shopId], references: [id])

  @@unique([shopId, date])
  @@index([shopId, date])
}

enum Role {
  OWNER
  STAFF
}

enum SaleType {
  CASH
  ONLINE
}

enum PayMode {
  CASH
  ONLINE
}

enum LoanStatus {
  PENDING
  CLOSED
}

enum LoanType {
  TAKEN
  GIVEN
}
